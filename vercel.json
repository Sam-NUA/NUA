{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "yarn install --frozen-lockfile",
      "buildCommand": "REACT_APP_BACKEND_URL= yarn build",
      "outputDirectory": "build",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "pos": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "server:app"
    },
    "bookings": {
      "root": "bookings-api",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "pos" } },
    { "source": "/bookings-api/:path*", "destination": { "service": "bookings" } },
    { "source": "/:path*", "destination": { "service": "web" } }
  ]
}
