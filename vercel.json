{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": {"codex/launch-audit-owner-access": false}},
  "services": {
    "web": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "yarn install --frozen-lockfile",
      "buildCommand": "PUBLIC_URL=/ REACT_APP_BACKEND_URL= yarn build",
      "outputDirectory": "build",
      "routes": [
        {
          "handle": "filesystem"
        },
        {
          "src": "/(.*)",
          "dest": "/index.html"
        }
      ]
    },
    "pos": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "server:app"
    },
    "bookings": {
      "root": "bookings-api",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "pos"
      }
    },
    {
      "source": "/bookings-api/(.*)",
      "destination": {
        "service": "bookings"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "regions": [
    "syd1"
  ],
  "crons": [
    {
      "path": "/api/cron/coursing-tick",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/booking-sync-drain",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/ash-hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/backup-drill-check",
      "schedule": "0 3 * * *"
    }
  ]
}
