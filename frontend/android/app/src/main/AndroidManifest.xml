<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- usesCleartextTraffic: services/printer.js's primary ESC/POS path
         fetches thermal printers over plain http://<lan-ip>:<port> --
         they're always local hardware, never an internet host, and have
         no TLS story at all. Android 9+ (API 28+) blocks ALL cleartext
         traffic app-wide by default, which would break that primary
         printing path, not just a fallback. The real API traffic to
         https://app.nuapos.com.au is unaffected either way since it's
         already HTTPS. See docs/platform/IOS_IPADOS_ARCHITECTURE.md for
         the equivalent iOS fix (NSAllowsLocalNetworking), which is
         scoped to local/private hosts only -- Android's manifest-level
         flag has no equivalent "local-only" granularity, so this is
         app-wide; narrowing it further would need a network security
         config keyed on a domain pattern, which doesn't fit a printer
         whose LAN IP varies per venue. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
